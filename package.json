{
  "name": "@intaqalab/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10"
  },
  "overrides": {
    "ngx-toastr": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  },
  "scripts": {
    "start": "nx run intaqalab:serve",
    "start:dev": "concurrently \"nx run intaqalab:serve\" \"nx run mock-data:serve\"",
    "start:mocks:app": "cross-env VITE_MOCKS_AUTH=true PROXY_TARGET=mocks nx run intaqalab:serve:mocks",
    "start:dev:mocks": "concurrently \"npm run start:mocks\" \"npm run start:mocks:app\"",
    "start:des": "nx serve intaqalab -c des",
    "start:pre": "nx serve intaqalab -c pre",
    "start:prod": "nx serve intaqalab -c production",
    "proxy:des": "cross-env PROXY_TARGET=des nx serve intaqalab -c des",
    "proxy:pre": "cross-env PROXY_TARGET=pre nx serve intaqalab -c pre",
    "proxy:pro": "cross-env PROXY_TARGET=pro nx serve intaqalab -c production",
    "prebuild": "node scripts/generate-version.mjs",
    "prebuild:dev": "node scripts/generate-version.mjs development",
    "prebuild:des": "node scripts/generate-version.mjs des",
    "prebuild:pre": "node scripts/generate-version.mjs pre",
    "prebuild:prod": "node scripts/generate-version.mjs pro",
    "build": "npx nx run intaqalab:build",
    "build:dev": "npx nx run intaqalab:build --configuration=development",
    "build:des": "npx nx run intaqalab:build --configuration=des",
    "build:pre": "npx nx run intaqalab:build --configuration=pre",
    "build:prod": "npx nx run intaqalab:build --configuration=production",
    "version:generate": "node scripts/generate-version.mjs",
    "env:report": "node scripts/compare-envs.mjs",
    "env:diff": "node scripts/compare-envs.mjs",
    "env:check": "node scripts/compare-envs.mjs --check",
    "test": "nx test",
    "test:data-access:ui": "nx test data-access --ui --watch",
    "test:all": "npx nx run-many --target=test --all --parallel=1 --run --maxWorkers=2 --output-style=static",
    "test:ci": "npm run test:all -- --skipNxCache",
    "vitest:ui": "cross-env NODE_OPTIONS='--max-old-space-size=8192' npx vitest --ui --maxWorkers=2",
    "test:admin": "nx test admin",
    "test:admin:watch": "nx test admin --watch",
    "test:admin:ui": "nx test admin --ui --watch",
    "test:calendar-trials": "nx test calendar-trials",
    "test:calendar-trials:watch": "nx test calendar-trials --watch",
    "test:calendar-trials:ui": "nx test calendar-trials --ui --watch",
    "test:planning": "nx test planning",
    "test:planning:watch": "nx test planning --watch",
    "test:planning:ui": "nx test planning --ui --watch",
    "test:trial-management": "nx test trial-management",
    "test:trial-management:watch": "nx test trial-management --watch",
    "test:trial-management:ui": "nx test trial-management --ui --watch",
    "test:event-log:ui": "nx test event-log --ui --watch",
    "test:master-data:ui": "nx test master-data --ui --watch",
    "test:core": "nx test core",
    "test:core:watch": "nx test core --watch",
    "test:core:ui": "nx test core --ui --watch",
    "test:data-access": "nx test data-access",
    "test:data-access:watch": "nx test data-access --watch",
    "test:ui": "nx test ui",
    "test:ui:watch": "nx test ui --watch",
    "test:ui:ui": "nx test ui --ui --watch",
    "test:utils": "nx test utils",
    "test:utils:watch": "nx test utils --watch",
    "test:utils:ui": "nx test utils --ui --watch",
    "test:pruebas": "nx test pruebas",
    "test:pruebas:watch": "nx test pruebas --watch",
    "test:pruebas:ui": "nx test pruebas --ui --watch",
    "test:shared-theme": "nx test shared-theme",
    "test:shared-theme:watch": "nx test shared-theme --watch",
    "test:shared-theme:ui": "nx test shared-theme --ui --watch",
    "test:warehouse-management": "nx test warehouse-management",
    "test:warehouse-management:watch": "nx test warehouse-management --watch",
    "test:warehouse-management:ui": "nx test warehouse-management --ui --watch",
    "start:mocks": "nx run mock-data:serve",
    "format": "prettier --write .",
    "affected:lint": "npx nx affected --target=lint",
    "lint:all": "npx nx run-many --target=lint --outputStyle=stream",
    "lint:quiet": "npx nx run-many --target=lint --outputStyle=stream --quiet",
    "verify": "bash ./tools/verify/verify.sh",
    "verify:watch": "node ./tools/verify/watch.mjs",
    "i18n:check": "node ./tools/verify/check-i18n.mjs",
    "i18n:check:update-baseline": "node ./tools/verify/check-i18n.mjs --update-baseline",
    "test:coverage": "npx vitest run --coverage",
    "test:coverage:ui": "cross-env NODE_OPTIONS='--max-old-space-size=8192' npx vitest --ui --coverage --maxWorkers=2",
    "test:execution": "nx test execution",
    "test:execution:watch": "nx test execution --watch",
    "test:execution:ui": "nx test execution --ui --watch",
    "test:execution:coverage": "nx test execution --coverage",
    "test:coverage:all": "npx nx run-many --target=test --codeCoverage=true",
    "coverage:merge": "node scripts/merge-coverage.js",
    "coverage:full": "npm run test:coverage:all && npm run coverage:merge",
    "agents:status": "node scripts/agents-version.mjs status",
    "agents:check": "node scripts/agents-version.mjs check",
    "check:planning-urls": "node scripts/check-planning-urls.mjs",
    "agents:bump": "node scripts/agents-version.mjs bump",
    "agents:sync": "node scripts/agents-version.mjs sync",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/material": "22.2.7",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "angular-auth-oidc-client": "^22.0.2",
    "angular-calendar": "^0.32.2",
    "angular-draggable-droppable": "^9.0.1",
    "angular-resizable-element": "^8.0.3",
    "calendar-utils": "^0.12.5",
    "chart.js": "^4.6.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^4.22.3",
    "ng2-pdf-viewer": "^10.4.0",
    "ngx-toastr": "^20.0.5",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.7",
    "@analogjs/vitest-angular": "2.9.7",
    "@angular-devkit/build-angular": "22.2.6",
    "@angular-devkit/core": "22.2.6",
    "@angular-devkit/schematics": "22.2.6",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@angular/language-service": "22.2.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "24.0.6",
    "@nx/esbuild": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/express": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@oxc-project/runtime": "^0.158.0",
    "@schematics/angular": "22.2.6",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "22.20.5",
    "@typescript-eslint/utils": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "^5.1.0",
    "angular-eslint": "22.6.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jsdom": "~31.0.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "22.2.6",
    "nx": "24.0.6",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "ts-node": "10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "nx": {
    "includedScripts": []
  }
}
