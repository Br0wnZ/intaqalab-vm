{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "neverConnectToCloud": true,
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:extract-i18n": {
      "cache": true,
      "inputs": ["production"],
      "outputs": ["{workspaceRoot}/apps/intaqalab/src/assets/i18n"]
    },
    "lint": [
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/.eslintrc.json",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/tools/eslint-rules/**/*",
          {
            "externalDependencies": ["eslint"]
          }
        ]
      }
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "test"
      },
      "include": [
        "apps/intaqalab/**/*",
        "libs/core/**/*",
        "libs/domain/admin/**/*",
        "libs/domain/calendar-trials/**/*",
        "libs/domain/event-log/**/*",
        "libs/domain/master-data/**/*",
        "libs/domain/trial/execution/**/*",
        "libs/domain/trial/planning/**/*",
        "libs/domain/trial/trial-management/**/*",
        "libs/domain/warehouse-management/**/*",
        "libs/pruebas/**/*",
        "libs/shared/config/**/*",
        "libs/shared/data-access/**/*",
        "libs/shared/theme/**/*",
        "libs/shared/ui/**/*",
        "libs/shared/utils/**/*"
      ]
    }
  ],
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-analog",
      "prefix": "inta",
      "standalone": true,
      "inlineStyle": true,
      "inlineTemplate": true,
      "routing": true,
      "addTailwind": true,
      "tags": "scope:(scope-name),type:app"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-analog",
      "style": "scss",
      "prefix": "inta",
      "changeDetection": "OnPush",
      "standalone": true,
      "inlineStyle": true,
      "inlineTemplate": true,
      "viewEncapsulation": "None",
      "tags": "scope:(scope-name|shared),type:(data-access|feature|ui|util)"
    },
    "@nx/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush",
      "standalone": true,
      "inlineStyle": true,
      "inlineTemplate": true,
      "viewEncapsulation": "None"
    },
    "@schematics/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush",
      "standalone": true,
      "inlineStyle": true,
      "inlineTemplate": true,
      "viewEncapsulation": "None"
    },
    "@nx/angular:directive": {
      "standalone": true
    },
    "@schematics/angular:directive": {
      "standalone": true
    },
    "@nx/angular:pipe": {
      "standalone": true
    },
    "@schematics/angular:pipe": {
      "standalone": true
    }
  },
  "defaultProject": "intaqalab"
}
